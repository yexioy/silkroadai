generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Order {
  id           String       @id @default(cuid())
  user_id      String?      @db.Uuid
  user         User?        @relation(fields: [user_id], references: [id])
  key_id       String?      @db.Uuid
  key          NewApiToken? @relation(fields: [key_id], references: [id])
  userEmail    String?      @map("user_email")
  userName     String?      @map("user_name")
  userNotes    String?      @map("user_notes")
  amount       Decimal      @db.Decimal(10, 2)
  payAmount    Decimal?     @map("pay_amount") @db.Decimal(10, 2)
  feeRate      Decimal?     @map("fee_rate") @db.Decimal(5, 4)
  rechargeCode String       @unique @map("recharge_code")
  status       OrderStatus  @default(PENDING)
  paymentType  String       @map("payment_type")

  paymentTradeNo String? @map("payment_trade_no")
  payUrl         String? @map("pay_url")
  qrCode         String? @map("qr_code")
  qrCodeImg      String? @map("qr_code_img")

  refundAmount        Decimal?  @map("refund_amount") @db.Decimal(10, 2)
  refundReason        String?   @map("refund_reason")
  refundAt            DateTime? @map("refund_at")
  forceRefund         Boolean   @default(false) @map("force_refund")
  refundRequestedAt   DateTime? @map("refund_requested_at")
  refundRequestReason String?   @map("refund_request_reason")
  refundRequestedBy   Int?      @map("refund_requested_by")

  expiresAt    DateTime  @map("expires_at")
  paidAt       DateTime? @map("paid_at")
  completedAt  DateTime? @map("completed_at")
  failedAt     DateTime? @map("failed_at")
  failedReason String?   @map("failed_reason")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  clientIp     String?   @map("client_ip")
  srcHost      String?   @map("src_host")
  srcUrl       String?   @map("src_url")

  // ── 订单类型 & 订阅相关 ──
  orderType           String            @default("balance") @map("order_type")
  planId              String?           @map("plan_id")
  plan                SubscriptionPlan? @relation(fields: [planId], references: [id])
  subscriptionGroupId Int?              @map("subscription_group_id")
  subscriptionDays    Int?              @map("subscription_days")
  providerInstanceId  String?           @map("provider_instance_id")

  // ── 白标租户(P1)──
  tenant_id String? @db.Uuid
  tenant    Tenant? @relation(fields: [tenant_id], references: [id])

  auditLogs AuditLog[]
  recharges RechargeLog[]

  @@index([user_id])
  @@index([status])
  @@index([expiresAt])
  @@index([createdAt])
  @@index([paidAt])
  @@index([paymentType, paidAt])
  @@index([orderType])
  @@index([tenant_id])
  @@map("orders")
}

enum OrderStatus {
  PENDING
  PAID
  RECHARGING
  COMPLETED
  EXPIRED
  CANCELLED
  FAILED
  REFUND_REQUESTED
  REFUNDING
  PARTIALLY_REFUNDED
  REFUNDED
  REFUND_FAILED
}

model AuditLog {
  id        String   @id @default(cuid())
  orderId   String   @map("order_id")
  order     Order    @relation(fields: [orderId], references: [id])
  action    String
  detail    String?  @db.Text
  operator  String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ── 渠道展示配置 ──
model Channel {
  id             String  @id @default(cuid())
  groupId        Int?    @unique @map("group_id")
  name           String
  platform       String  @default("claude")
  rateMultiplier Decimal @map("rate_multiplier") @db.Decimal(10, 4)
  description    String? @db.Text
  models         String? @db.Text
  features       String? @db.Text
  sortOrder      Int     @default(0) @map("sort_order")
  enabled        Boolean @default(true)

  // ── 白标租户(P1)──
  tenant_id String? @db.Uuid
  tenant    Tenant? @relation(fields: [tenant_id], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@index([tenant_id])
  @@map("channels")
}

// ── 订阅套餐配置 ──
model SubscriptionPlan {
  id            String   @id @default(cuid())
  groupId       Int?     @map("group_id")
  name          String
  description   String?  @db.Text
  price         Decimal  @db.Decimal(10, 2)
  originalPrice Decimal? @map("original_price") @db.Decimal(10, 2)
  validityDays  Int      @default(30) @map("validity_days")
  validityUnit  String   @default("day") @map("validity_unit") // day | week | month
  features      String?  @db.Text
  productName   String?  @map("product_name")
  forSale       Boolean  @default(false) @map("for_sale")
  sortOrder     Int      @default(0) @map("sort_order")

  // ── 白标租户(P1)──
  tenant_id String? @db.Uuid
  tenant    Tenant? @relation(fields: [tenant_id], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders Order[]

  @@index([forSale, sortOrder])
  @@index([tenant_id])
  @@map("subscription_plans")
}

// ── 系统配置 ──
model SystemConfig {
  key       String   @id
  value     String   @db.Text
  group     String   @default("general")
  label     String?
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([group])
  @@map("system_configs")
}

// ── 支付服务商实例（多实例轮询） ──
model PaymentProviderInstance {
  id             String  @id @default(cuid())
  providerKey    String  @map("provider_key") // easypay, alipay, wxpay, stripe
  name           String // display name like "易支付A"
  config         String  @db.Text // encrypted JSON credentials
  supportedTypes String  @default("") @map("supported_types") // comma-separated: alipay,wxpay,stripe
  enabled        Boolean @default(true)
  sortOrder      Int     @default(0) @map("sort_order")
  limits         String? @db.Text // JSON per-channel limits: { "alipay": { "dailyLimit": 10000, "singleLimit": 1000 } }
  refundEnabled  Boolean @default(false) @map("refund_enabled")

  // ── 白标租户(P1)──
  tenant_id String? @db.Uuid
  tenant    Tenant? @relation(fields: [tenant_id], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([providerKey])
  @@index([providerKey, enabled])
  @@index([tenant_id])
  @@map("payment_provider_instances")
}

// ============================================
// Silk Road AI Portal — B3 路线 (W2 D4)
// ============================================
// 后端从 LiteLLM 切到 new-api。User / Key / RechargeLog / Order 关系
// 全部指向 new-api 的 user/token 模型。

// ── 白标租户(P1 地基,P6 完整化)──
// null tenant_id 视为平台主体;所有现存数据在 add_user_role_and_tenant migration
// 内回填到平台主体那一行(固定 UUID,见 src/lib/admin/tenant-scope.ts
// PLATFORM_TENANT_ID)。本期(P1)只打地基:Tenant 表 + 核心表 tenant_id 列 +
// role-based admin。partner 自有客户 / 定价目录 / 渠道分组 / 品牌等完整白标留 P6。
model Tenant {
  id                  String   @id @default(uuid()) @db.Uuid
  slug                String   @unique // 'silkroadai' = 平台主体
  brand_name          String
  primary_domain      String?
  status              String   @default("active") // active / suspended
  prepaid_balance_cny Decimal  @default(0) @db.Decimal(20, 4) // 白标预付池(P6 用,P1 先建列)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  users                      User[]
  orders                     Order[]
  channels                   Channel[]
  subscription_plans         SubscriptionPlan[]
  payment_provider_instances PaymentProviderInstance[]
  catalog_models             CatalogModel[]
  channel_groups             ChannelGroup[]

  @@map("tenants")
}

// admin 角色 — 取代单 ADMIN_TOKEN(后者保留为 break-glass = superadmin 等价)。
// 角色序:customer < staff < admin < superadmin(见 src/lib/admin/auth.ts roleAtLeast)。
enum UserRole {
  customer
  staff // 白标 partner 运营 / 平台客服,受 tenant scope 限制
  admin // 平台管理员
  superadmin // 平台超管,全局全权(= 现 ADMIN_TOKEN 等价)
}

// ── Portal 自有用户表 ──
model User {
  id                String     @id @default(uuid()) @db.Uuid
  email             String     @unique
  // Nullable since W3 D6: OAuth-only users have no password until they
  // separately set one via the forgot-password flow.
  password_hash     String?
  // Boolean kept for backward-compat with login / user routes that already
  // read `user.email_verified`. New writes always update both fields together.
  email_verified    Boolean    @default(false)
  // Source of truth for "did we verify, and when". null = not verified yet.
  email_verified_at DateTime?
  nickname          String?
  avatar_url        String?
  last_login_at     DateTime?
  last_login_ip     String?
  locale            String     @default("zh-CN") @db.VarChar(10)
  status            UserStatus @default(active)

  // ── admin 角色 + 白标租户(P1)──
  // role: 取代单 ADMIN_TOKEN;customer < staff < admin < superadmin。日常 admin
  //   登录走 role >= staff 的 session(见 src/lib/admin/auth.ts)。授予 superadmin
  //   走独立脚本 scripts/grant-admin.ts(不在 migration 里硬编码邮箱)。
  // tenant_id: null 视为平台主体;migration 把所有现存 user 回填到平台主体那行。
  //   所有 admin 数据查询经 tenantScope() 施加租户隔离(P6 白标靠它)。
  role      UserRole @default(customer)
  tenant_id String?  @db.Uuid
  tenant    Tenant?  @relation(fields: [tenant_id], references: [id])

  // ── new-api 后端关联 ──
  // newapi_user.id 是 int(不是 UUID)
  newapi_user_id            Int?      @unique
  // new-api 那边的 username,日志查询接口需要 username 而不是 id
  newapi_username           String?   @unique
  // 32-字符 secret;portal 用它 act-as 该客户调 /api/token/* 等 per-user endpoint
  newapi_access_token       String?
  // ── PR-T1 portal-managed system token(W7 D5 Phase 0)──
  // portal 内部服务(image gen / chat UI / 自部署模型 / 等)调 new-api 的
  // /v1/* 路径时需要客户的 sk-key 形式认证 — 但客户管理的 NewApiToken 行可
  // 以被客户随时撤销,会影响 portal 服务可用性。新增一个隐藏 token(name
  // = 'portal-internal',unlimited_quota=true),客户 /keys 页不展示,server
  // 侧 read-only 用作 image-gen 等 server-managed 调用的 Bearer。
  // - newapi_system_token_id: new-api 那边的 token.id(int → string),用于
  //   将来 rotate / delete 的引用。
  // - newapi_system_token_value: 完整 48 字符 raw token value(无 sk- 前缀
  //   ;use site 用 formatTokenForDisplay() 拼);只在 server-side 读。
  // 首次访问通过 getOrCreateSystemToken() 懒加载;失败不阻塞业务路径,下
  // 次调用再试(retries are idempotent — race-safe via WHERE … IS NULL CAS)。
  newapi_system_token_id    String?
  newapi_system_token_value String?
  // 余额缓存(raw quota,不是 USD/CNY);实时数据从 new-api 拉
  newapi_quota_cache        BigInt?
  newapi_used_quota_cache   BigInt?
  newapi_cached_at          DateTime?

  // 关系
  keys                      NewApiToken[]
  orders                    Order[]
  recharges                 RechargeLog[]
  password_reset_tokens     PasswordResetToken[]
  email_verification_tokens EmailVerificationToken[]
  oauth_accounts            OAuthAccount[]
  usage_aggregate_cache     UsageAggregateCache[]
  image_generations         ImageGeneration[]
  analytics_events          AnalyticsEvent[]
  oss_config                UserOssConfig?

  // ── session 失效控制 ──
  // JWT payload 带 tv = session_token_version。verifySession 时如果 token tv
  // 与当前 user 这个值不等就拒。改密 / 主动登出全设备时自增,等价于踢登。
  session_token_version Int @default(1)

  // ── 首充福利(W6 D1)──
  // false = 此 user 还没拿过首充 20% bonus,下次 recharge 成功时触发并 flip
  // 为 true(同事务内 CAS lock,防同 user 并发双发)。executeRecharge 失败
  // 回滚事务时此字段不会被永久锁,用户下次仍可拿首充 bonus。
  first_recharge_bonus_granted Boolean @default(false)

  // ── 邀请码(W7 D4)──
  // 用户注册时填写的邀请码(可选)。register handler 仅在 isValidInviteCode
  // 通过时写入,所以读到非空值意味着「注册当时 INVITE_CODES env 里有」。
  // 但 bonus rate 仍要在 executeRecharge 内 re-validate(env 可能已变,操作员
  // 可以软撤销码而不必 DB migration)。索引留给后续 analytics 用(按码统计
  // 注册转化等),不参与 query path 的功能性查询。
  invite_code String?

  // ── 余额低提醒(W6 D2)──
  // threshold_cny:用户在 /balance 页配置的提醒阈值(CNY)。0 = 关闭提醒,
  //   范围 [0, 1000]。BalanceAlertScheduler 每 1h 扫一次,余额 ≤ 阈值 → 发邮件。
  // last_sent_at:最近一次提醒邮件发送时间。null = 从未发过 / 最近一次充值
  //   后被 reset 清空。同一用户 24h 内只发一次提醒(防爆邮)。
  //   executeRecharge 成功事务中会清为 null,使下次余额低时立即可触发,不
  //   等 24h cooldown(用户充完了又快花完属于真实风险信号)。
  balance_alert_threshold_cny Decimal?  @default(10.00) @db.Decimal(8, 2)
  balance_alert_last_sent_at  DateTime?

  // ── 代理分销归属(PR-U1)──
  // 注册时由 register handler 填:
  //   - inviter_code_id      = ResellerInviteCode.id(命中的码,FK,SetNull on delete)
  //   - inviter_reseller_id  = Reseller.id(归属代理,从 code 反查得到)
  //   - attribution_expires_at = registered_at + 24 months(保护期截止;
  //                              过期后该 user 的 recharge 不再发 commission)
  // 全部 nullable:未走代理路径(直接注册或用 env invite_code)= null。
  // executeRecharge 在 commission hook 中读 inviter_reseller_id !=null AND
  // attribution_expires_at > now 才发 commission。
  inviter_code_id        String?   @db.Uuid
  inviter_reseller_id    String?   @db.Uuid
  attribution_expires_at DateTime?

  // ── 注册风控元数据(PR-U1)──
  // signup_ip / signup_ua:register handler 写入一次,后续不修改。
  // 用于 24h 同 IP 注册 ≥3 同代理码 → manual_review flag 检测;
  // 也为 W11+ 其他防控规则(同 UA + IP 注册多账号等)预留。
  // 因为 IP/UA 字段较长且可为 null,用 String? 不加索引(全表扫描成本可控,
  // 防控查询 24h 窗口 + reseller_id 已有索引)。
  signup_ip String?
  signup_ua String?

  // 代理身份 — 用户加入代理计划后,1:1 关联到 Reseller。
  // 普通用户此关联为空。删除 user 时级联清掉 reseller(onDelete: Cascade
  // 在 Reseller 侧定义)。
  reseller Reseller?

  // 代理引流的 commission 流水(作为客户被 attribute 时,每次 recharge
  // 触发一条)。SetNull on user delete 保留 reseller 的历史 GMV。
  reseller_commissions_as_customer ResellerCommission[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([email])
  @@index([status])
  // W7 D4: index for analytics queries grouping/counting by invite_code
  // (e.g. "how many signups per code, what's the conversion rate").
  // Not on a query hot-path — register/login/dashboard never filter by
  // invite_code — so partial index isn't worth the upgrade.
  @@index([invite_code])
  // PR-U1: reseller customer-list query path (按 inviter_reseller_id 取
  // 该代理所有引流客户),按 created_at desc 分页。WHERE inviter_reseller_id=?
  // 是 hot path(每次 reseller 看 /reseller/customers 都会跑)。
  @@index([inviter_reseller_id, created_at(sort: Desc)])
  // PR-U1: 同 IP 24h 内注册次数检查 — 防控 #2 IP throttle。
  @@index([signup_ip, created_at(sort: Desc)])
  // P1: admin role 筛选 + 租户隔离查询。
  @@index([role])
  @@index([tenant_id])
  @@map("users")
}

enum UserStatus {
  active
  disabled
  banned
}

// ── new-api Token(原 LiteLLMKey)──
model NewApiToken {
  id      String @id @default(uuid()) @db.Uuid
  user_id String @db.Uuid
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // new-api 那边的 token(完整 sk-xxx,只在创建时拿到一次)
  newapi_token_id    Int    @unique
  newapi_token_value String @unique
  // 客户给 key 起的名字 = new-api 的 token.name
  key_alias          String

  // 缓存(实时数据从 new-api 拉,这里只是 portal 显示用)
  // W6 D4: cached_used_quota 改为非 nullable + default 0,新增 cached_used_at
  // 作为 60s TTL 阈值。原 cached_remain_quota / last_synced_at 保留为 W2 D4
  // legacy(目前只被 /api/user/route.ts 投影,无写路径)— 将来如果 quota-cache
  // 重构再清理。
  cached_remain_quota BigInt?
  cached_used_quota   BigInt    @default(0)
  cached_used_at      DateTime?
  last_synced_at      DateTime?

  // 模型限制(冗余存,真实约束在 new-api 那边)
  model_limits_enabled Boolean  @default(false)
  model_limits         String[] @default([])

  status KeyStatus @default(active)

  // ── 档次(P3)──
  // 客户建 key 时选的档次 = ChannelGroup.key('pool' | 'official')。决定建
  // token 时下发给 new-api 的 group(经 ChannelGroup.newapi_group 解耦:
  // pool→'default' 保现有,official→'official')。现有 token 全部回填 'pool',
  // 其 new-api group 仍是 'default',零迁移、行为不变。
  tier String @default("pool")

  orders    Order[]
  recharges RechargeLog[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([user_id])
  @@index([newapi_token_id])
  @@map("newapi_tokens")
}

enum KeyStatus {
  active
  disabled
  expired
}

// ── 密码重置 token(W3 D4) ──
// 不存裸 token,存 sha256(token);邮件里发裸 token,DB 只存 hash。
model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token_hash String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  @@index([user_id, used_at])
  @@map("password_reset_tokens")
}

// ── 邮箱验证 token(W3 D5) ──
// 完全镜像 PasswordResetToken 设计。Token 24h 过期(reset 1h,verification 24h —
// 客户首次注册到点验证邮件可能延迟)。User.email_verified_at = null = 未验证。
model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token_hash String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  @@index([user_id, used_at])
  @@map("email_verification_tokens")
}

// ── OAuth 账户绑定(W3 D6 起)──
// 一个 portal user 可有多个 oauth_account(google + github + 未来),通过
// (provider, provider_account_id) 唯一标识上游账号。OAuth-only user 的
// User.password_hash 是 null。
model OAuthAccount {
  id                  String   @id @default(uuid()) @db.Uuid
  user_id             String   @db.Uuid
  user                User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  provider            String   @db.VarChar(32)
  provider_account_id String   @db.VarChar(255)
  created_at          DateTime @default(now())

  @@unique([provider, provider_account_id])
  @@index([user_id])
  @@map("oauth_accounts")
}

// ── 充值流水(审计 + 累计计算)──
model RechargeLog {
  id       String       @id @default(uuid()) @db.Uuid
  user_id  String       @db.Uuid
  user     User         @relation(fields: [user_id], references: [id])
  key_id   String?      @db.Uuid
  key      NewApiToken? @relation(fields: [key_id], references: [id])
  order_id String?
  order    Order?       @relation(fields: [order_id], references: [id])

  // W8 D8: widened 12,4 → 20,4 as defense-in-depth. The W8 D8 incident wrote
  // raw quota (1–2 亿) into balance_before/after (then numeric(12,4), max ~1 亿)
  // → numeric field overflow → recharge tx rollback → webhook-retry double-charge.
  // executeRecharge now stores ¥CNY (quotaToCny) in balance_*; raw quota stays
  // only in newapi_quota_added (BigInt). ¥CNY display values can never approach
  // the 20,4 ceiling, so this column type can't be the failure point again.
  amount         Decimal @db.Decimal(20, 4)
  balance_before Decimal @db.Decimal(20, 4)
  balance_after  Decimal @db.Decimal(20, 4)

  // ── new-api 审计冗余 ──
  // 充给 new-api 的 raw quota 增量(对应 amount 经汇率换算)
  newapi_quota_added BigInt?
  // 首充 20% bonus 中 bonus 部分占了多少 raw quota(W6 D1)。
  // newapi_quota_added 是「主 + bonus」的总和,bonus_quota_added 是其中的
  // bonus 子项,审计可以反查首充福利发了多少。非首充行恒为 0。
  bonus_quota_added  BigInt? @default(0)
  // 充值落到哪个 new-api user(冗余:RechargeLog.user.newapi_user_id 也能拿到)
  newapi_user_id     Int?

  // 充值类型
  source RechargeSource @default(payment)
  note   String?

  // PR-U1: 代理 commission 反向(一次充值 ≤ 一条 commission;
  // 见 ResellerCommission.recharge_log_id @unique 约束)。
  reseller_commission ResellerCommission?

  created_at DateTime @default(now())

  @@index([user_id])
  @@index([key_id])
  @@index([order_id])
  @@index([created_at])
  @@map("recharge_logs")
}

enum RechargeSource {
  payment // 支付到账
  manual // 管理员手动充
  refund // 退款(负数)
  promo // 推广奖励
  adjustment // 余额调整
}

// ── 用量聚合缓存(W6 D5)──
// /dashboard 和 /usage 都需要按时间窗口聚合 new-api log 表(分页 1-50 页 ×
// 每页 1000 条 = 50k 条)。一次 fetch 慢(2-5s),5min TTL 复用结果。
//
// payload JSON 结构:{ totalUsedQuota: number, totalCalls: number,
//   byModel: [{ model: string, calls: number, quota: number }] }(quota 已是
// 数字,不会越 INT 上限,因为 new-api log.quota 也是 int)。
//
// PK = (user_id, period) — 同一 user 每个 period 唯一一行;period 串行枚举
// 'last_7_days' | 'last_30_days' | 'last_month' | 'all_time'(以及 /usage
// 页对应的 '7d' | '30d' | 'all',与 aggregator UsagePeriod 类型保持一致)。
model UsageAggregateCache {
  user_id     String   @db.Uuid
  period      String
  payload     Json
  computed_at DateTime
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([user_id, period])
  @@map("usage_aggregate_cache")
}

// ── 生图历史(PR-T1 W7 D5)──
// 每次客户调 POST /api/portal/image/generate 落一行。新-api 真扣 quota,
// 我们 mirror cost 到 cost_usd 给前端展示;真账数仍以 new-api log 为准。
//
// r2_keys: string[] — 每张图在 R2 中的 key,形如
//   "image-gen/{user_id}/{generation_id}/{index}.png"
// 服务端组装 R2 public URL 给前端(或前端自己拼)。
//
// expires_at: 默认 created_at + 30 days;is_favorite=true 时清 null(永久)。
// is_deleted: soft delete;30 天后由 cleanup cron 真删(R2 objects + DB row)。
model ImageGeneration {
  id             String    @id @default(uuid()) @db.Uuid
  user_id        String    @db.Uuid
  prompt         String    @db.Text
  model_name     String
  size           String
  count          Int
  /// string[]: R2 keys for the n images returned
  r2_keys        Json
  cost_usd       Decimal   @db.Decimal(10, 6)
  quota_consumed BigInt
  is_favorite    Boolean   @default(false)
  is_deleted     Boolean   @default(false)
  created_at     DateTime  @default(now())
  expires_at     DateTime?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_favorite, created_at(sort: Desc)])
  @@index([expires_at])
  @@map("image_generations")
}

// ── 客户端 / 服务端事件埋点(PR-T3 W7 D5)──
//
// 轻量 analytics — 替代 Mixpanel / PostHog 的初版方案。客户端通过
// POST /api/portal/analytics 写入,服务端在 /api/portal/image/generate
// 等关键路径上也直接写入(rate-limit 失败 / R2 失败 / 大单等)。
//
// event_type 严格 whitelist(server-side validate),防客户端塞乱七八糟。
// properties 是 free-form Json — 各 event_type 的 schema 由 collector 文档
// 维护,不强约束。后续接 ops dashboard(/admin/stats)按 event_type +
// 时间窗聚合查询。
//
// user_id 设 SET NULL on delete:用户被删除后 analytics 行保留(脱敏),
// 利于历史趋势分析。
model AnalyticsEvent {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String?  @db.Uuid
  event_type String
  properties Json
  created_at DateTime @default(now())

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([event_type, created_at(sort: Desc)])
  @@index([user_id, created_at(sort: Desc)])
  @@map("analytics_events")
}

// ─────────────────────────────────────────────────────────────────────────
// 代理分销系统(PR-U1)— 4 models + 4 enums
// ─────────────────────────────────────────────────────────────────────────
//
// 整体语义:
//   - Reseller            = 1:1 User,代理身份 + tier + 结算信息
//   - ResellerInviteCode  = N:1 Reseller,代理可创建多个码(限 10 个 active),
//                           customers 注册时填这个码建立 attribution
//   - ResellerCommission  = N:1 Reseller(挣钱方)+ N:1 User(消费方)
//                           + 1:1 RechargeLog(对账锚点;一次充值 ≤ 一条 commission)
//   - ResellerSettlement  = N:1 Reseller,每月一行(reseller_id, period_month) unique
//
// Money path 关键约束(money path 出错 = real loss,审 PR 时优先看):
//   1. commission_rate 历史性:已 confirmed 的 commission 不补差;tier 升级
//      后只影响下一笔。rate 在 INSERT 时快照存到 row。
//   2. 24 月保护期:user.attribution_expires_at 过期后,executeRecharge 不
//      再写 commission(brief 硬约束)。
//   3. 14d hold:status=pending → confirmed 由 ResellerCommissionScheduler
//      推。退款窗口内充值 → commission 仍处 pending,可被 refund hook 撤销
//      (refund 流当前不动 commission,W11+ Phase 2 再补)。
//   4. 一次充值 ≤ 一条 commission:RechargeLog.id 唯一索引在 ResellerCommission
//      上,executeRecharge 内的 tx 同时写 RechargeLog + ResellerCommission,
//      失败一起回滚。
//   5. 大额风控:commission_amount > ¥100,000 → admin_review_required=true,
//      cron 跳过自动 confirm,等 operator 手动审。

model Reseller {
  id      String @id @default(uuid()) @db.Uuid
  user_id String @unique @db.Uuid
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // tier 仅缓存值,真实档位由 cumulative_gmv + TIER_THRESHOLDS 计算。
  // 写入路径:commission hook 内每次写完 commission 后 re-compute,跨阈值
  // 时同事务更新此字段 + 写 AnalyticsEvent(reseller_tier_upgraded)。
  tier           ResellerTier   @default(bronze)
  cumulative_gmv Decimal        @default(0) @db.Decimal(14, 4) // CNY total GMV; 14,4 cover billion-CNY scale
  status         ResellerStatus @default(active)

  // 提现 / 结算信息 — 代理 join 时可空,后期可在 /reseller dashboard 补填。
  // 当代理点 [申请提现] 时校验三个字段都非空。
  // method 是个 free-form string('alipay' / 'wechat' / 'bank' / 'manual'),
  // 不上 enum:operator 结算多样,enum 限制反而麻烦。
  settle_method  String?
  settle_account String?
  settle_name    String?

  // Relations(反向)
  invite_codes ResellerInviteCode[]
  commissions  ResellerCommission[]
  settlements  ResellerSettlement[]

  joined_at  DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([status])
  @@index([tier])
  @@map("resellers")
}

model ResellerInviteCode {
  id          String   @id @default(uuid()) @db.Uuid
  reseller_id String   @db.Uuid
  reseller    Reseller @relation(fields: [reseller_id], references: [id], onDelete: Cascade)

  // 自定义码,大写 + 数字 + 中划线,3-20 字符。规范化存储 = 用户输入 toUpperCase
  // 后落库。register handler 比对时也 toUpperCase。unique 全表,与 env
  // INVITE_CODES allow-list 冲突在 API endpoint create 时 reject(避免双重
  // 语义)。
  code  String  @unique
  label String? // 代理自标:"朋友圈 5/24" / "X Twitter" 等,UI 列表展示用

  // is_active=false = 软删除,保留历史 attribution(已被某 user 用过的码不
  // 能真删,DELETE FK RESTRICT)。soft-delete 仅影响新 register 不能再用。
  is_active Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([reseller_id, is_active])
  @@map("reseller_invite_codes")
}

model ResellerCommission {
  id          String   @id @default(uuid()) @db.Uuid
  reseller_id String   @db.Uuid
  reseller    Reseller @relation(fields: [reseller_id], references: [id], onDelete: Restrict)

  // 客户(消费方)— 若 user 被删除,commission 行保留以追溯历史 GMV,
  // user_id 置 NULL。
  user_id String? @db.Uuid
  user    User?   @relation(fields: [user_id], references: [id], onDelete: SetNull)

  // 1:1 对锚点 RechargeLog(防双发 commission)— unique 索引保证。
  // RestrictOnDelete:RechargeLog 不会被删除(append-only),但保险起见 Restrict。
  recharge_log_id String      @unique @db.Uuid
  recharge_log    RechargeLog @relation(fields: [recharge_log_id], references: [id], onDelete: Restrict)

  attributed_gmv    Decimal @db.Decimal(12, 4) // 与 recharge_log.amount 相等(CNY),快照存便于查询
  commission_rate   Decimal @db.Decimal(5, 4) // 0.1000 / 0.1500 / 0.2000;rate 在 INSERT 时快照
  commission_amount Decimal @db.Decimal(12, 4) // attributed_gmv × commission_rate(CNY)

  status                CommissionStatus @default(pending)
  admin_review_required Boolean          @default(false) // commission_amount > ¥100,000 时为 true,cron 跳过

  // 14 天 hold 窗口截止时刻;cron 每小时扫,hold_until < now 且 status=pending
  // AND admin_review_required=false → flip 到 confirmed。
  hold_until DateTime
  settled_at DateTime? // settlement.status=paid 时由 settlement endpoint 一并写

  created_at DateTime @default(now())

  @@index([reseller_id, status])
  @@index([reseller_id, created_at(sort: Desc)]) // /reseller/commissions 翻页路径
  @@index([status, hold_until]) // cron 扫 pending → confirmed
  @@index([user_id]) // /reseller/customers 聚合每客户累计 GMV
  @@map("reseller_commissions")
}

model ResellerSettlement {
  id          String   @id @default(uuid()) @db.Uuid
  reseller_id String   @db.Uuid
  reseller    Reseller @relation(fields: [reseller_id], references: [id], onDelete: Restrict)

  // period_month 用 "YYYY-MM" UTC 字符串(避免 timezone 边界 bug)。
  // 月初 cron 计算 = 上一月所有 confirmed commission 聚合。
  period_month     String
  total_commission Decimal @default(0) @db.Decimal(14, 4)
  commission_count Int     @default(0)

  // 状态机(brief Q2):
  //   pending   = cron 月初创建,等代理申请提现
  //   requested = 代理点了 [申请提现](POST /settlement/request)
  //   paid      = operator 手动打款后改(更新 paid_at + paid_tx_ref)
  status SettlementStatus @default(pending)

  requested_at DateTime?
  paid_at      DateTime?
  paid_tx_ref  String? // operator 手填打款凭证(支付宝/微信 txn id)
  notes        String? // operator 备注

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // 同代理 + 同月份只能一行(upsert key)。
  @@unique([reseller_id, period_month])
  @@index([reseller_id, status])
  @@index([status, period_month])
  @@map("reseller_settlements")
}

enum ResellerStatus {
  active
  suspended
  banned
}

enum ResellerTier {
  bronze
  silver
  gold
}

enum CommissionStatus {
  pending
  confirmed
  settled
}

enum SettlementStatus {
  pending
  requested
  paid
}

// ── 客户自定义 OSS 配置(W9 D3,PR-C)──
// proxy 生图默认传 silkroadai R2;客户可在 /settings/storage 配自己的
// S3 兼容存储(R2 / 阿里 OSS / 腾讯 COS / AWS S3 / 自建 S3 兼容)。
// secret_access_key 用 AES-256-GCM 加密存(key = PORTAL_OSS_ENC_KEY env,
// 64 hex = 32 bytes,见 src/lib/oss/encryption.ts)。
// 一个 user 最多一份配置(user_id unique);清除配置 = 删行,回默认 R2。
model UserOssConfig {
  id      String @id @default(uuid()) @db.Uuid
  user_id String @unique @db.Uuid
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // 'r2' | 'aliyun-oss' | 'tencent-cos' | 's3' | 's3-custom'
  provider                    String
  endpoint                    String?
  bucket                      String
  region                      String?
  access_key_id               String
  secret_access_key_encrypted String
  // 客户的公网访问前缀(自定义域名 / CDN),拼 `${prefix}/${key}` 返给客户
  public_url_prefix           String
  cdn_enabled                 Boolean @default(false)

  // active(测试通过,生效)/ inactive(暂停,回默认 R2)/ test-failed
  status            String    @default("active")
  last_test_at      DateTime?
  last_test_message String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("user_oss_configs")
}

// ─────────────────────────────────────────────────────────────────────────
// 模型目录 + 定价(P2 — 管理后台 §4.2)
// ─────────────────────────────────────────────────────────────────────────
// 把"改价 / 管模型"从 SSH 跑脚本搬到后台。改价 = 插新 CatalogPrice 版本行
// (effective_from,不 UPDATE 覆盖)→ 历史可复算 / 审计可追溯;改价保存后
// 轻量 sync 折算成 new-api per-channel model_ratio/completion_ratio(决策①,
// 一上线即生效)。P4 计费接管后,CatalogPrice 成为 portal 自有计费的事实源。

// 我们对客户暴露的"模型",与 new-api 渠道模型名解耦。
model CatalogModel {
  id             String   @id @default(uuid()) @db.Uuid
  tenant_id      String?  @db.Uuid // null=平台主体;白标可覆盖(P6)
  tenant         Tenant?  @relation(fields: [tenant_id], references: [id])
  slug           String // 客户调用名,如 'claude-opus-4-7'
  display_name   String // 'Claude Opus 4.7'
  vendor         String // anthropic / openai / google / deepseek …
  modality       String   @default("chat") // chat / image / embedding
  context_window Int?
  enabled        Boolean  @default(true)
  sort_order     Int      @default(0)
  // 该模型在各档次下对应 new-api 的渠道 + 上游模型名(sync 用)。形如
  // { "pool": { "channel_id": 3, "upstream_model": "gpt-5.4" }, "official": {...} }。
  // P2 档次先用 'default' / 现有 channel,结构留好向 P3(pool/official)扩展。
  upstream_map   Json
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  prices CatalogPrice[]

  @@unique([tenant_id, slug])
  @@index([tenant_id, sort_order])
  @@map("catalog_models")
}

// 定价规则:每个模型 × 档次 一行价格(版本化:改价插新行,不覆盖)。
// "当前价" = 该 (model, tier) 下 effective_from <= now 的最新一行。
model CatalogPrice {
  id       String       @id @default(uuid()) @db.Uuid
  model_id String       @db.Uuid
  model    CatalogModel @relation(fields: [model_id], references: [id], onDelete: Cascade)
  tier     String // 'pool' | 'official'(P2 先 'default')

  // 我们对客户的零售价(¥/1M token);图片模型用 per_image_cny。
  input_cny_per_1m  Decimal? @db.Decimal(12, 4)
  output_cny_per_1m Decimal? @db.Decimal(12, 4)
  per_image_cny     Decimal? @db.Decimal(12, 4)
  // 成本价(可选,毛利看板用)
  cost_cny_per_1m   Decimal? @db.Decimal(12, 4)

  effective_from DateTime @default(now()) // 改价留历史,不覆盖
  created_by     String?  @db.Uuid // 哪个 admin 改的(详情另记 AuditLog)

  created_at DateTime @default(now())

  @@index([model_id, tier, effective_from])
  @@map("catalog_prices")
}

// ─────────────────────────────────────────────────────────────────────────
// 渠道分组 / 档次(P3 — 管理后台 §4.3 + §6)
// ─────────────────────────────────────────────────────────────────────────
// 客户建 key 选档次(低价号池 pool / 官方稳定 official)。路由逻辑【零代码留在
// new-api】(它原生按 token.group → channel.group 匹配)。portal 只:建 token 时
// 把 group 设成该档的 newapi_group + 后台登记/展示。
//
// ⚠️ portal 档次 key 与 new-api group 名【解耦】:pool → 'default'(复用现有
// 渠道组,现有 token 已是 default,零迁移);official → 'official'(运维在 new-api
// 新建该 group 并把官方渠道归进去)。绝不批量改现有 token 的 group。
model ChannelGroup {
  id                 String   @id @default(uuid()) @db.Uuid
  tenant_id          String?  @db.Uuid // P1 tenant 维度;回填平台主体
  tenant             Tenant?  @relation(fields: [tenant_id], references: [id])
  key                String // portal 档次标识:'pool' | 'official'
  display_name       String // '低价号池' / '官方稳定'
  description        String?
  // 真正下发到 new-api token.group 的名字(与 portal key 解耦)。
  newapi_group       String
  tier_level         Int      @default(0) // 排序 / 档位:pool=0, official=1
  enabled            Boolean  @default(true)
  is_default         Boolean  @default(false) // 客户不选时的默认档(设在 pool)
  // 该档对应 new-api 哪些 channel id —— 运维登记,纯展示/审计;路由由 new-api
  // 自己按 group 做,portal 不据此路由。
  newapi_channel_ids Int[]    @default([])
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@unique([tenant_id, key])
  @@index([tenant_id, enabled])
  @@map("channel_groups")
}
