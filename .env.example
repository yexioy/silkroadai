# ============================================
# Silk Road AI Portal — 环境变量
# ============================================

# 数据库
DATABASE_URL="postgresql://portal:CHANGE_ME@localhost:5432/silkroadai_portal"

# --- new-api 后端(B3 路线主链路)---
# 本地走 SSH 隧道转发 VPS 的 :3000:
#   ssh -fN -L 3000:localhost:3000 -o ServerAliveInterval=60 vps
NEWAPI_BASE_URL="http://localhost:3000"
# 在 admin.silkroadai.io 后台 → 个人设置 → 系统访问令牌 生成(31-32 字符)
NEWAPI_ADMIN_TOKEN="CHANGE_ME"
# admin user 的 int id,默认 root = 1
NEWAPI_ADMIN_USER_ID=1
# new-api QuotaPerUnit(1 USD = 多少 raw quota,默认 500_000;
# 如果在 admin 后台改了 system → quota_per_unit 必须同步)
NEWAPI_QUOTA_PER_USD=500000
# 美元转人民币汇率(展示给客户用;客户充 100 元 → portal 算 quota 调 add_quota)
USD_TO_CNY_RATE=7.2

# --- LiteLLM 旧后端(W1 路线产物,W2 D5 后已停用)---
# 暂时保留作 fallback / 排查;LITELLM_MASTER_KEY 上线前必须 rotate
# 一旦 W3 D1 在 VPS 关停 LiteLLM 容器,这两行可以删
LITELLM_BASE_URL="http://localhost:4000"
LITELLM_MASTER_KEY="sk-master-CHANGE_ME"

# Portal 自己的认证
PORTAL_JWT_SECRET="CHANGE_ME_$(openssl rand -hex 32)"
PORTAL_JWT_EXPIRES="7d"
ADMIN_TOKEN="CHANGE_ME"      # 管理员后门,bypass JWT

# 公开域名(邮件里链接用,reset-password 邮件用 ${NEXT_PUBLIC_APP_URL}/reset-password?token=...)
# 本地开发:http://localhost:3002,生产:https://silkroadai.io
#
# Two related vars:
# - APP_URL: plain runtime env, read by server-side OAuth callback for
#   redirect base. Changes take effect on container restart with new env.
# - NEXT_PUBLIC_APP_URL: inlined at `next build` time so SSR + CSR see the
#   same value. Kept as a back-compat fallback. Changing this on a running
#   container has NO effect on server-side reads (must rebuild).
#
# W7 D3 amend: collapsed from portal.silkroadai.io subdomain to apex —
# OAuth state cookies couldn't survive cross-subdomain start (apex) →
# callback (subdomain), causing state_mismatch on every Google login.
# portal.silkroadai.io now 301-redirects to apex via Caddy.
APP_URL="https://silkroadai.io"
NEXT_PUBLIC_APP_URL="https://silkroadai.io"

# Cookie domain for cross-subdomain session + OAuth state cookies.
# - Prod: ".silkroadai.io" so silkroadai.io and (transient) portal.silkroadai.io
#   share session + OAuth state during the W7 D3 apex collapse.
# - Local dev: leave empty/unset — browsers refuse Domain= for localhost.
# - Staging: set to your eTLD+1 (e.g. ".staging.silkroadai.io").
#
# When unset/empty, cookies are host-scoped (the pre-W7-D3 default).
BRAND_COOKIE_DOMAIN=""

# SMTP 邮件(W3 D4 forgot-password 用,W3 D5 注册验证邮件复用)— 腾讯企业邮箱
SMTP_HOST="smtp.exmail.qq.com"
SMTP_PORT=465
# 端口 465 = SSL(自动 secure),587 = STARTTLS。getMailer() 按端口判断 secure
SMTP_USER="<企业邮箱地址,例如 noreply@silkroadai.io>"
SMTP_PASS="<企业邮箱客户端授权码或密码,1Password 存档>"
SMTP_FROM="<from 地址,通常等于 SMTP_USER>"

# Google OAuth(W3 D6 客户用 Google 一键登录)
# 1) cloud.google.com 创建 OAuth 2.0 Client ID(Web application)
# 2) Authorized redirect URIs 必须 = ${NEXT_PUBLIC_APP_URL}/api/auth/oauth/google/callback
#    (本地:http://localhost:3002/api/auth/oauth/google/callback)
GOOGLE_OAUTH_CLIENT_ID="CHANGE_ME.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="CHANGE_ME"
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3002/api/auth/oauth/google/callback"

# GitHub OAuth(W3 D7 客户用 GitHub 一键登录)
# 1) github.com/settings/developers 注册 OAuth App(Settings → Developer settings → OAuth Apps → New)
# 2) Authorization callback URL 必须 = ${NEXT_PUBLIC_APP_URL}/api/auth/oauth/github/callback
#    (本地:http://localhost:3002/api/auth/oauth/github/callback)
# 3) GitHub 不支持 PKCE,只用 state CSRF cookie 防重放
GITHUB_OAUTH_CLIENT_ID="CHANGE_ME"
GITHUB_OAUTH_CLIENT_SECRET="CHANGE_ME"
GITHUB_OAUTH_REDIRECT_URI="http://localhost:3002/api/auth/oauth/github/callback"

# 易支付(复用 Sub2ApiPay 已有配置)
PAYMENT_PROVIDERS=easypay
ENABLED_PAYMENT_TYPES=alipay,wxpay
EASY_PAY_PID="CHANGE_ME"
EASY_PAY_PKEY="CHANGE_ME"
EASY_PAY_API_BASE="https://yourepay.com"
EASY_PAY_NOTIFY_URL="https://silkroadai.io/api/easy-pay/notify"
EASY_PAY_RETURN_URL="https://silkroadai.io/pay/result"

# 充值规则
ORDER_TIMEOUT_MINUTES=15
MIN_RECHARGE_AMOUNT=10
MAX_RECHARGE_AMOUNT=1000
MAX_DAILY_RECHARGE_AMOUNT=5000
PRODUCT_NAME="Silk Road AI 余额充值"

# 默认新用户的 Key 配置
DEFAULT_NEW_USER_MAX_BUDGET=0          # 新用户默认 0 余额
DEFAULT_NEW_USER_MODELS=""             # 空 = 所有模型,或逗号分隔指定: "claude-opus-4-7,deepseek-v4-flash"

# 端口
APP_PORT=3002

# Sentry(W5 D4 — error reporting,缺值则 SDK 处于 no-op,所有 captureException
# 调用都安全 no-op 不报错。在 sentry.io 注册项目后填进 prod .env 启用)。
SENTRY_DSN=
